<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

<style name="Theme.TwinsenRadio" parent="Theme.Material3.DayNight.NoActionBar">
<item name="colorPrimary">@color/brand</item>
<item name="colorOnPrimary">@color/on_brand</item>
<item name="android:statusBarColor" tools:targetApi="21">@color/brand_dark</item>
<item name="android:windowLightStatusBar">false</item>
</style>

<!--
Style ekranu Opcji. Wydzielone, bo powtarzaja sie kilkanascie razy -
wpisywanie ich przy kazdym wierszu robilo z layoutu sciane atrybutow
i wlasnie stad brala sie jego niechlujnosc.
-->

<style name="SectionHeader" parent="">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
<item name="android:textColor">?attr/colorPrimary</item>
<item name="android:paddingBottom">4dp</item>
</style>

<style name="SectionNote" parent="">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
<item name="android:alpha">0.75</item>
</style>

<style name="SettingSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:layout_marginTop">12dp</item>
<item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
</style>

<style name="SettingNote" parent="">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:layout_marginTop">2dp</item>
<item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
<item name="android:alpha">0.75</item>
</style>

<style name="SectionDivider" parent="">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">1dp</item>
<item name="android:layout_marginVertical">16dp</item>
<item name="android:background">?attr/colorOutlineVariant</item>
</style>

<!--
Motyw dla projekcji Android Auto. AA czyta stad kolor akcentu i tla.
Uwaga: sam podzial dzien/noc jest sterowany przez auto, nie przez aplikacje.
-->

<style name="CarTheme" parent="android:Theme">
<item name="android:colorPrimary">@color/brand</item>
<item name="android:colorPrimaryDark">@color/brand_dark</item>
<item name="android:colorAccent">@color/brand_accent</item>
</style>

</resources>
